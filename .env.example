# Google Gemini API Key (Opsional - untuk generator butir soal AI di server/Vercel)
GEMINI_API_KEY=

# Firebase Client Configuration (Opsional - default sudah terpasang dari firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID=elearningcbt-sebayuloka
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=elearningcbt-sebayuloka.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=elearningcbt-sebayuloka.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=(default)
